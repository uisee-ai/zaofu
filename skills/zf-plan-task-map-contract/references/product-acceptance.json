        "verification_tier": "e2e",
        "assertions": [
          {
            "assertion_id": "saved-content-visible",
            "statement": "提交成功后界面显示与服务端保存值一致的内容",
            "observation_kind": "dom",
            "mandatory": true
          }
        ]
      }
    ],
    "provider_qualification": {
      "required_for_goal": false,
      "providers": [],
      "ttl_seconds": 0
    }
  }
}
