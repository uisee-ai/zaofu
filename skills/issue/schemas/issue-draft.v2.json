{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/issue-draft.v2.json",
  "title": "Provider-neutral Issue Draft v2",
  "type": "object",
  "required": [
    "schema_version", "draft_id", "title", "bug_description",
    "reproduction_steps", "actual_behavior", "expected_behavior",
    "attachment_context", "environment", "project_version", "additional_context", "revision"
  ],
  "properties": {
    "schema_version": { "const": "issue-draft.v2" },
    "draft_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "maxLength": 240 },
    "bug_description": { "type": "string", "maxLength": 8000 },
    "reproduction_steps": { "type": "string", "maxLength": 8000 },
    "actual_behavior": { "type": "string", "maxLength": 8000 },
    "expected_behavior": { "type": "string", "maxLength": 8000 },
    "attachment_context": { "type": "string", "maxLength": 8000 },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "os": { "type": "string" },
        "version": { "type": "string" },
        "arch": { "type": "string" },
        "source": { "type": "string" },
        "detected_at": { "type": "string" }
      }
    },
    "project_version": { "type": "string", "maxLength": 120 },
    "additional_context": { "type": "string", "maxLength": 8000 },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
